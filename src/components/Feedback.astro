---
---

<div
  data-feedback
  class="mt-12 rounded-none border border-border bg-card p-4"
>
  <p class="text-sm font-medium text-foreground">Was this helpful?</p>
  <div data-feedback-buttons class="mt-3 inline-flex rounded-none border border-border divide-x divide-border">
    <button
      type="button"
      data-feedback-choice="yes"
      aria-pressed="false"
      class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-none px-4 py-2 text-sm text-foreground transition-colors hover:bg-accent"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8" cy="8" r="6.5" />
        <path d="M5.5 6.2h.8M9.7 6.2h.8M5.5 9.5c.8.9 1.6 1.3 2.5 1.3s1.7-.4 2.5-1.3" stroke-linecap="round" />
      </svg>
      Yes
    </button>
    <button
      type="button"
      data-feedback-choice="partially"
      aria-pressed="false"
      class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-none px-4 py-2 text-sm text-foreground transition-colors hover:bg-accent"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8" cy="8" r="6.5" />
        <path d="M5 9.5h6M5.5 6h.8M9.7 6h.8" stroke-linecap="round" />
      </svg>
      Partially
    </button>
    <button
      type="button"
      data-feedback-choice="no"
      aria-pressed="false"
      class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-none px-4 py-2 text-sm text-foreground transition-colors hover:bg-accent"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8" cy="8" r="6.5" />
        <path d="M5.5 6.2h.8M9.7 6.2h.8M5.3 11.3c.8-.9 1.5-1.3 2.7-1.3 1.1 0 1.9.4 2.7 1.3" stroke-linecap="round" />
      </svg>
      No
    </button>
  </div>
  <p data-feedback-thanks class="mt-3 hidden text-sm text-muted-foreground">
    Thanks for your feedback.
  </p>
</div>

<script is:inline>
  (() => {
    const KEY = 'docs-feedback:';
    const show = (widget, choice) => {
      const buttons = widget.querySelector('[data-feedback-buttons]');
      const thanks = widget.querySelector('[data-feedback-thanks]');
      if (buttons) buttons.hidden = true;
      if (thanks) {
        thanks.classList.remove('hidden');
        if (choice) thanks.textContent = `Thanks for your feedback (${choice}).`;
      }
    };
    const init = () => {
      document.querySelectorAll('[data-feedback]').forEach((widget) => {
        const page = window.location.pathname;
        let saved = null;
        try {
          saved = localStorage.getItem(KEY + page);
        } catch {}
        if (saved) {
          show(widget, saved);
          return;
        }
        widget.addEventListener('click', (event) => {
          const button = event.target.closest('[data-feedback-choice]');
          if (!button) return;
          const choice = button.getAttribute('data-feedback-choice');
          widget.querySelectorAll('[data-feedback-choice]').forEach((el) => {
            const selected = el === button;
            el.setAttribute('aria-pressed', selected ? 'true' : 'false');
            el.classList.toggle('bg-accent', selected);
            el.classList.toggle('text-primary', selected);
            el.classList.toggle('font-semibold', selected);
          });
          try {
            localStorage.setItem(KEY + page, choice ?? '');
          } catch {}
          show(widget, choice);
        });
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
