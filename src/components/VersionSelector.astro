---
interface Props {
  versions: string[];
  current: string;
}

const { versions, current } = Astro.props;
---

{
  versions.length > 1 && (
    <label class="block">
      <span class="sr-only">Documentation version</span>
      <select
        class="w-full rounded-none border border-border bg-card px-3 py-2 text-sm text-foreground"
        value={current}
      >
        {versions.map((version) => (
          <option value={version} selected={version === current}>
            {version}
          </option>
        ))}
      </select>
    </label>
  )
}
