---
interface Props {
  kind: 'info' | 'warning' | 'danger' | 'success';
  title?: string;
}

const { kind, title } = Astro.props;

const styles: Record<Props['kind'], { wrap: string; icon: string; paths: string }> = {
  info: {
    wrap: 'bg-[#E7F3F5] text-[#1F3A3E] dark:bg-[#262D2F] dark:text-[#D8ECEF] border-[#22A3B3]/30',
    icon: 'bg-[#22A3B3] text-white',
    paths: 'M8 5v4M8 11.5v.5M8 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13z',
  },
  success: {
    wrap: 'bg-[#E7F3F5] text-[#1F3A3E] dark:bg-[#262D2F] dark:text-[#D8ECEF] border-[#22A3B3]/30',
    icon: 'bg-[#22A3B3] text-white',
    paths: 'M3.5 8.5l3.5 3.5 5.5-7',
  },
  warning: {
    wrap: 'bg-[#FFF3E6] text-[#5C3400] dark:bg-[#33231A] dark:text-[#FFD9A8] border-[#FF8A00]/40',
    icon: 'bg-[#FF8A00] text-[#1d1d1d]',
    paths: 'M8 5v4M8 11.5v.5M8 2L2.5 13.5h11L8 2z',
  },
  danger: {
    wrap: 'bg-[#F9E6F0] text-[#5C0033] dark:bg-[#33202B] dark:text-[#F2BFD8] border-[#80004D]/30',
    icon: 'bg-[#80004D] text-white',
    paths: 'M8 5v4M8 11.5v.5M8 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13z',
  },
};

const s = styles[kind];
---

<div class={`flex gap-3 rounded-none border p-4 text-sm leading-6 ${s.wrap}`} role="note">
  <span class={`flex h-6 w-6 shrink-0 items-center justify-center rounded-none ${s.icon}`} aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d={s.paths} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <div class="min-w-0">
    {title && <p class="font-semibold">{title}</p>}
    <div class={title ? 'mt-1' : ''}>
      <slot />
    </div>
  </div>
</div>
