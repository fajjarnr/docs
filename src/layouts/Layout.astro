---
import '@/styles/globals.css';
import SearchBox from '@/components/SearchBox';
import MainNav from '@/components/MainNav';
import CookieBanner from '@/components/CookieBanner';
interface Props {
  title?: string;
  description?: string;
}

const { title = 'Docs Fajar', description = 'Documentation for Docs Fajar.' } = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const dark = localStorage.getItem('theme') === 'dark';
          document.documentElement.classList.toggle('dark', dark);
        } catch {}
      })();
    </script>
  </head>
  <body class="flex min-h-full flex-col">
    <header
      class="sticky top-0 z-30 bg-background/90 backdrop-blur-md shadow-[0_1px_0_rgb(28_29_30/0.02)] dark:shadow-[0_1px_0_rgb(254_255_255/0.06)]"
    >
      <div
        id="scroll-progress"
        role="progressbar"
        aria-label="Reading progress"
        class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-primary motion-reduce:hidden"
      ></div>
      <div
        class="mx-auto flex h-16 w-full max-w-[1536px] items-center gap-4 px-4 sm:px-6 lg:px-8"
      >
        <a href="/" class="shrink-0 text-xl font-semibold tracking-tight text-foreground"
          >Docs<span class="text-primary">.</span>Fajar</a
        >
        <SearchBox id="header-search" className="mx-auto hidden w-full max-w-md md:block" />
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle dark mode"
          class="ml-auto inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-none border border-border text-foreground transition-colors hover:bg-accent md:ml-0"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="hidden dark:block">
            <circle cx="8" cy="8" r="3.5" />
            <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M12.6 3.4l-1 1M4.4 11.6l-1 1" stroke-linecap="round" />
          </svg>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="dark:hidden">
            <path d="M13.5 9.5A5.5 5.5 0 016.5 2.5a5.5 5.5 0 107 7z" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <MainNav client:load currentPath={path} />
    </header>
    <main class="mx-auto w-full max-w-[1536px] flex-1 px-4 sm:px-6 lg:px-8">
      <slot />
    </main>
    <footer class="border-t border-border py-8 text-sm text-muted-foreground">
      <div class="mx-auto w-full max-w-[1536px] px-4 text-center sm:px-6 lg:px-8">
        <p>Docs Fajar</p>
        <p class="mt-1">Static site on Cloudflare Pages. Design system in DESIGN.md.</p>
      </div>
    </footer>
    <CookieBanner client:load />
    <script is:inline>
      (() => {
        const bar = () => document.getElementById('scroll-progress');
        const toggle = () => document.querySelector('[data-theme-toggle]');
        const update = () => {
          const el = bar();
          if (!el) return;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
          el.style.transform = `scaleX(${ratio})`;
        };
        const onToggle = () => {
          const dark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch {}
        };
        const init = () => {
          update();
          toggle()?.addEventListener('click', onToggle);
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
