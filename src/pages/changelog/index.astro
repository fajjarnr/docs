---
import Layout from '@/layouts/Layout.astro';
import { changelog } from '@/data/pages';

const entries = [...changelog].sort((a, b) => b.date.localeCompare(a.date));
const tags = [...new Set(entries.map((entry) => entry.tag))];
---

<Layout title="Changelog | Docs Fajar">
  <div class="mx-auto max-w-3xl py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
      <a href="/" class="hover:text-foreground">Home</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-foreground">Changelog</span>
    </nav>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-foreground">Changelog</h1>
    <p class="mt-2 text-sm text-muted-foreground">Tags: {tags.join(', ')}</p>
    <div class="mt-8 space-y-8">
      {
        entries.map((entry) => (
          <article class="rounded-none border border-border bg-card p-6">
            <p class="text-sm text-muted-foreground">{entry.date}</p>
            <div class="mt-2 flex items-center gap-2">
              <span class="rounded-none bg-accent px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-placeholder-ink">
                {entry.version}
              </span>
              <span class="rounded-none bg-accent px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-placeholder-ink">
                {entry.tag}
              </span>
            </div>
            <h2 class="mt-3 text-xl font-semibold text-card-foreground">{entry.title}</h2>
            <p class="mt-2 text-sm text-muted-foreground">{entry.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</Layout>
