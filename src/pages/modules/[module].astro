---
import Layout from '@/layouts/Layout.astro';
import ArticleShell from '@/components/ArticleShell.astro';
import { getCollection, render } from 'astro:content';
import { modules, moduleNav, versions } from '@/data/pages';
import '@/components/markdown.css';

export async function getStaticPaths() {
  const entries = await getCollection('modules');
  const bySlug = new Map(entries.map((e) => [e.id.replace(/\.mdx$/, ''), e]));
  return modules.map((page) => {
    const slug = page.path.split('/').pop() ?? '';
    return { params: { module: slug }, props: { page, entry: bySlug.get(slug) ?? null } };
  });
}

const { page, entry } = Astro.props;

const title = entry?.data.title ?? page.title;
const description = entry?.data.description ?? page.description;
const updated = entry?.data.updated ?? page.updated ?? '2026-10-11';
const heroImage = entry?.data.heroImage ?? page.heroImage;

const { Content } = entry ? await render(entry) : { Content: null };
---

<Layout title={`${title} | Modules | Docs Fajar`}>
  <ArticleShell
    sidebar={moduleNav}
    current={page.path}
    versions={[...versions]}
    headings={[
      { slug: 'topology', text: 'Topology', depth: 2 },
      { slug: 'configuration', text: 'Configuration', depth: 2 },
      { slug: 'reference', text: 'Reference', depth: 2 },
    ]}
    updated={updated}
  >
    <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
      <a href="/" class="hover:text-foreground">Modules</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-foreground">{title}</span>
    </nav>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-foreground">{title}</h1>
    <p class="mt-6 text-muted-foreground">{description}</p>
    {heroImage && (
      <img src={heroImage} alt={`${title} topology diagram`} class="mt-6 w-full rounded-none border border-border" />
    )}
    {Content && (
      <div class="mdx-body mt-6">
        <Content />
      </div>
    )}
  </ArticleShell>
</Layout>
